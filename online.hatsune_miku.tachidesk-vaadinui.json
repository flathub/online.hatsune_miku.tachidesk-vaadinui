{
  "app-id": "online.hatsune_miku.tachidesk-vaadinui",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.openjdk25"
  ],
  "command": "vaaui.sh",
  "finish-args": [
    "--env=PATH=/app/jre/bin:/usr/bin:/app/bin/",
    "--share=network",
    "--persist=.TachideskVaadinUI",
    "--socket=x11",
    "--share=ipc"
  ],
  "modules": [
    {
      "name": "openjdk",
      "buildsystem": "simple",
      "build-commands": [
        "/usr/lib/sdk/openjdk25/install.sh"
      ]
    },
    {
      "name": "Tachidesk-VaadinUI",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 tachidesk-vaadinui.sh /app/bin/vaaui.sh",
        "mv Tachidesk-VaadinUI.jar /app/bin/Tachidesk-VaadinUI.jar",
        "install -D -m0644 ${FLATPAK_ID}.desktop -t /app/share/applications/",
        "install -D -m0644 ${FLATPAK_ID}.png -t /app/share/icons/hicolor/512x512/apps/",
        "install -D -m0644 ${FLATPAK_ID}.appdata.xml -t /app/share/metainfo/"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/Suwayomi/Suwayomi-VaadinUI/releases/download/v2.0.3/Tachidesk-VaadinUI-2.0.3.jar",
